<Project>
  <PropertyGroup>
    <Version>2.0.0</Version>
    <VersionPrefix>2.0.0</VersionPrefix>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <InformationalVersion>2.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Meloberry CLI</Product>
    <Company>Meloberry</Company>
    <RepositoryUrl>https://github.com/doc-shashank/meloberry-cli/</RepositoryUrl>
    <Description>Portable .NET 10 Clean CLI for authoring, linting, packaging, and rendering interactive Meloberry Study Sessions and Quizzes.</Description>

    <NuGetAudit>false</NuGetAudit>
    <RestoreBuildInParallel>false</RestoreBuildInParallel>
    <BuildInParallel>false</BuildInParallel>
    <UseSharedCompilation>false</UseSharedCompilation>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AppName" Value="$(Company)" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>
</Project>
