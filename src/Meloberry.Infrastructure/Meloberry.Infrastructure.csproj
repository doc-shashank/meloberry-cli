<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meloberry.Application\Meloberry.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\Assets\katex\katex.min.js" LogicalName="Meloberry.Infrastructure.Web.Assets.katex.katex.min.js" />
    <EmbeddedResource Include="Web\Assets\katex\katex.min.css" LogicalName="Meloberry.Infrastructure.Web.Assets.katex.katex.min.css" />
    <EmbeddedResource Include="Web\Assets\katex\fonts\*.woff2" LogicalName="Meloberry.Infrastructure.Web.Assets.katex.fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
